# Server environment variables. Export in your shell or hosting settings.
# npm start does not automatically load this file.
PORT=3000
DATA_DIR=./data
ADMIN_EMAIL=
ADMIN_PASSWORD=
FINANCE_EMAIL=
FINANCE_PASSWORD=
PROJECT_EMAIL=
PROJECT_PASSWORD=
DONOR_EMAIL=
DONOR_PASSWORD=
# Set NODE_ENV=production only behind HTTPS; enables Secure cookies.

# Supabase PostgreSQL Session pooler URI. Keep server-side only.
DATABASE_URL=
# Render sets this to true to prevent accidental ephemeral storage.
REQUIRE_DATABASE_URL=false
# Optional Supabase CA certificate, if needed for TLS verification.
DATABASE_CA_CERT=
